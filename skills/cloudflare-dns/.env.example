# Cloudflare credentials for the cloudflare-dns skill.
# Copy to .env (kept out of git) and fill in your values.
#
# Create an API token at https://dash.cloudflare.com/profile/api-tokens
# with permissions:  Zone / Zone / Read  +  Zone / DNS / Edit
CLOUDFLARE_API_TOKEN=
# Optional — narrows zone listing to one account (from the dashboard URL).
CLOUDFLARE_ACCOUNT_ID=
