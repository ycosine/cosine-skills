# Cloudflare R2 credentials for the cloudflare-r2 skill.
# Copy to .env (git-ignored) or ~/.config/cloudflare-r2-skill/.env and fill in.
#
# Account ID: dashboard URL or R2 overview page ("Account ID").
CLOUDFLARE_ACCOUNT_ID=
#
# An API token with R2 read/write. Easiest: dashboard -> R2 -> "Manage API
# tokens" -> Create Account API token, permission "Admin Read & Write".
# Paste its "Token value" here. The S3 key pair is derived from it, so this
# single token covers both bucket management and uploads/downloads.
CLOUDFLARE_R2_API_TOKEN=
#
# Optional: explicit S3 keys (the "Access Key ID" / "Secret Access Key" shown
# once at token creation). Only needed if you want object commands to use a
# different, e.g. bucket-scoped, key pair.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
